@startuml
left to right direction

actor User
actor Member
actor Librarian
actor "Mail server" as Mail <<system>>

rectangle "Library system" {

    usecase "Search the catalog" as Search
    usecase "Reserve a book" as Reserve
    usecase "Renew a loan" as Renew
    usecase "Lend copies" as Lend

    usecase Return as "Register a return
    --
    extension points
    late return"

    usecase "Manage the catalog" as Manage
    usecase "Check borrowing rights" as Check
    usecase "Suspend the member" as Suspend
}

User <|-- Member
User <|-- Librarian

User -- Search

Member -- Reserve
Member -- Renew

Librarian -- Lend
Librarian -- Return
Librarian -- Manage

Mail -- Reserve

Renew ..> Check : <<include>>
Lend ..> Check : <<include>>

Return ..> Suspend : <<extend>>
'Suspend ..> Return  : <<extend>>
note right of Suspend
  condition: returned late
  extension point: late return
end note

@enduml